# Krishimitra AI - Environment Variables Configuration

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=hi

# Authentication & Session Security
JWT_SECRET=krishimitra-super-secure-production-jwt-secret-key-2026
ADMIN_SECRET_KEY=krishi-admin-secure-passcode

# Database (Supabase / PostgreSQL)
# Optional in demo mode; if not provided, Krishimitra AI seamlessly uses the robust in-memory SQLite/KV store
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Machine Learning Inference Service (FastAPI)
# Point to your deployed Render/HuggingFace or local FastAPI microservice
# If unreachable, the built-in Next.js ML fallback engine guarantees uninterrupted offline/edge predictions
FASTAPI_ML_URL=http://localhost:8000
FASTAPI_API_KEY=krishi-ml-secret-token

# AI Chatbot (Anthropic Claude 3.5 Sonnet / Haiku)
# If not provided, an intelligent agro-expert RAG engine provides grounded advisory answers
ANTHROPIC_API_KEY=sk-ant-api03-your-anthropic-key

# Weather Service (OpenWeatherMap)
# If not provided, agro-climatic regional fallback data is automatically utilized
OPENWEATHER_API_KEY=your-openweather-api-key

# Location & Maps (Google Maps Platform)
# If not provided, interactive OpenStreetMap/Leaflet fallback is smoothly activated
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
NEXT_PUBLIC_GOOGLE_MAPS_KEY=your-google-maps-api-key

# SMS / OTP Verification (Twilio or MSG91)
# In development mode, OTP is logged to console and prefilled with default demo OTP '123456'
SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=AC_your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_SERVICE_SID=VA_your_twilio_service_sid
